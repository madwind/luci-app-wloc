#!/bin/sh

. /usr/share/libubox/jshn.sh

INIT=/etc/init.d/wloc
RULES=/usr/libexec/wloc/rules.sh
STATE=/var/run/wloc/status.json
CAINFO=/etc/wloc/ca.info.json
VERSION_CACHE=/var/run/wloc/package.version

load_runtime_state() {
	armed=0
	configured_clients=0
	ca_fingerprint=''
	accepted_connections=0
	passthrough_connections=0
	tls_intercepted=0
	wloc_requests=0
	patched_responses=0
	delivered_responses=0
	patch_failures=0
	last_event=''
	last_error=''
	service_reason=''
	session_started_at=0
	updated_at=0
	runtime_log=''
	runtime_log_enabled=0
	activity_rows=''

	[ -s "$STATE" ] || return 0
	json_load_file "$STATE" 2>/dev/null || return 0
	json_get_vars armed:0 configured_clients:0 ca_fingerprint \
		accepted_connections:0 passthrough_connections:0 tls_intercepted:0 \
		wloc_requests:0 patched_responses:0 delivered_responses:0 patch_failures:0 \
		last_event last_error session_started_at:0 updated_at:0 runtime_log \
		runtime_log_enabled:0
	if json_select client_activity 2>/dev/null; then
		json_get_keys activity_keys
		for activity_index in $activity_keys; do
			json_select "$activity_index" || continue
			activity_error=''
			json_get_vars client_id latitude longitude last_location_at:0 success:0
			json_get_var activity_error last_error
			case "$client_id" in ''|*[!A-Za-z0-9_-]*) client_id='';; esac
			[ -n "$client_id" ] && activity_rows="${activity_rows}${client_id} ${latitude:-0} ${longitude:-0} ${last_location_at:-0} ${success:-0} ${activity_error:-}
"
			json_select ..
		done
		json_select ..
	fi
}

package_version() {
	local version
	version="$(cat "$VERSION_CACHE" 2>/dev/null || true)"
	case "$version" in ''|*[!A-Za-z0-9._+~-]*)
		version="$(apk list --installed luci-app-wloc 2>/dev/null \
			| sed -n 's/^luci-app-wloc-\([^ ]*\).*/\1/p' | head -n 1)"
		case "$version" in *[!A-Za-z0-9._+~-]*) version='';; esac
		[ -z "$version" ] || printf '%s\n' "$version" >"$VERSION_CACHE"
		;;
	esac
	printf '%s' "$version"
}

emit_status() {
	local configured enabled version table_dump rules_present attempts intercepted counters conflict order_conflict prerouting_priority detected_priorities daemon_running service_reason
	load_runtime_state
	configured=0
	uci -q show wloc | grep -q '=device$' && configured=1
	enabled="$(uci -q get wloc.main.enabled 2>/dev/null || echo 0)"
	case "$enabled" in 1) enabled=1;; *) enabled=0;; esac
	version="$(package_version)"
	table_dump="$(nft list table inet wloc 2>/dev/null)" && rules_present=1 || rules_present=0
	counters="$(printf '%s\n' "$table_dump" | awk '
		/wloc owned MAC redirect|wloc owned AP redirect/ {
			if (match($0, /counter packets [0-9]+/)) {
				value = substr($0, RSTART + 16, RLENGTH - 16)
				attempts += value
				intercepted += value
			}
		}
		END { print attempts + 0, intercepted + 0 }')"
	attempts="${counters%% *}"
	intercepted="${counters#* }"
	case "$attempts" in ''|*[!0-9]*) attempts=0;; esac
	case "$intercepted" in ''|*[!0-9]*) intercepted=0;; esac
	conflict=0
	[ "$attempts" -gt 0 ] && [ "$accepted_connections" -eq 0 ] && conflict=1
	order_conflict="$(cat /var/run/wloc/order-conflict 2>/dev/null || true)"
	case "$order_conflict" in 1|unknown) conflict=1;; esac
	prerouting_priority="$(cat /var/run/wloc/prerouting.priority 2>/dev/null || true)"
	case "$prerouting_priority" in -[0-9]*|[0-9]*) :;; *) prerouting_priority='';; esac
	detected_priorities="$(cat /var/run/wloc/prerouting.details 2>/dev/null || true)"
	service_reason="$(cat /var/run/wloc/start-error 2>/dev/null || true)"
	daemon_running=0
	pidof wlocd >/dev/null 2>&1 && daemon_running=1
	if [ "$daemon_running" -eq 0 ] && [ "$enabled" -eq 1 ] && [ -z "$service_reason" ]; then
		service_reason='service is not running; check the system log'
	fi
	if [ "$daemon_running" -eq 1 ] && [ "$armed" -eq 0 ]; then
		case "$last_event" in
			lease_failed)
				service_reason='runtime rule refresh failed; interception is disabled'
				[ -z "$last_error" ] || service_reason="$service_reason: $last_error"
				;;
			esac
	elif [ "$daemon_running" -eq 1 ] && [ "$rules_present" -eq 0 ]; then
		service_reason='runtime interception rules are missing'
	elif [ "$daemon_running" -eq 1 ] && [ "$conflict" -eq 1 ]; then
		service_reason='transparent-proxy rule order conflict; see the runtime log'
	fi
	if [ -z "$ca_fingerprint" ] && [ -s "$CAINFO" ]; then
		json_load_file "$CAINFO" 2>/dev/null && json_get_var ca_fingerprint fingerprint_sha256
	fi

	json_init
	json_add_boolean configured "$configured"
	json_add_boolean enabled "$enabled"
	json_add_string version "$version"
	json_add_boolean running "$daemon_running"
	json_add_boolean rules_present "$rules_present"
	json_add_boolean armed "$armed"
	json_add_int configured_clients "$configured_clients"
	json_add_int accepted_connections "$accepted_connections"
	json_add_int passthrough_connections "$passthrough_connections"
	json_add_int tls_intercepted "$tls_intercepted"
	json_add_int wloc_requests "$wloc_requests"
	json_add_int patched_responses "$patched_responses"
	json_add_int delivered_responses "$delivered_responses"
	json_add_int patch_failures "$patch_failures"
	json_add_string last_event "$last_event"
	json_add_string last_error "$last_error"
	json_add_string service_reason "$service_reason"
	json_add_int session_started_at "$session_started_at"
	json_add_int updated_at "$updated_at"
	json_add_boolean runtime_log_enabled "$runtime_log_enabled"
	json_add_string runtime_log "$runtime_log"
	json_add_int interception_attempts "$attempts"
	json_add_int intercepted_packets "$intercepted"
	json_add_boolean path_conflict "$conflict"
	json_add_boolean order_conflict "$([ "$order_conflict" = 1 ] && echo 1 || echo 0)"
	json_add_string order_state "${order_conflict:-missing}"
	json_add_string prerouting_priority "$prerouting_priority"
	json_add_string detected_priorities "$detected_priorities"
	json_add_string fingerprint "$ca_fingerprint"
	json_add_string profile_url '/wloc-ca.mobileconfig'
	json_add_array client_activity
	while read -r client_id activity_lat activity_lon activity_at activity_success activity_error; do
		[ -n "$client_id" ] || continue
		case "$activity_at" in ''|*[!0-9]*) activity_at=0;; esac
		case "$activity_success" in 1|true) activity_success=1;; *) activity_success=0;; esac
		json_add_object
		json_add_string client_id "$client_id"
		json_add_string latitude "$activity_lat"
		json_add_string longitude "$activity_lon"
		json_add_int last_location_at "$activity_at"
		json_add_boolean success "$activity_success"
		json_add_string last_error "$activity_error"
		json_close_object
	done <<EOF
$activity_rows
EOF
	json_close_array
	json_dump
}

emit_test() {
	local table_dump attempts intercepted counters
	table_dump="$(nft list table inet wloc 2>/dev/null || true)"
	counters="$(printf '%s\n' "$table_dump" | awk '
		/wloc owned MAC redirect|wloc owned AP redirect/ {
			if (match($0, /counter packets [0-9]+/)) {
				value = substr($0, RSTART + 16, RLENGTH - 16)
				attempts += value
				intercepted += value
			}
		}
		END { print attempts + 0, intercepted + 0 }')"
	attempts="${counters%% *}"
	intercepted="${counters#* }"
	json_init
	pidof wlocd >/dev/null 2>&1 && json_add_boolean daemon 1 || json_add_boolean daemon 0
	[ -n "$table_dump" ] && json_add_boolean nftables 1 || json_add_boolean nftables 0
	printf '%s\n' "$table_dump" | grep -q 'elements = {' && json_add_boolean lease 1 || json_add_boolean lease 0
	[ -s /www/wloc-ca.mobileconfig ] && json_add_boolean mobileconfig 1 || json_add_boolean mobileconfig 0
	json_add_int interception_attempts "${attempts:-0}"
	json_add_int intercepted_packets "${intercepted:-0}"
	json_dump
}

emit_access_points() {
	local object status ssid bssid interface
	json_init
	json_add_array access_points
	for object in $(ubus -S -t 3 list 'hostapd.*' 2>/dev/null || true); do
		case "$object" in hostapd.*) :;; *) continue;; esac
		status="$(ubus -S -t 3 call "$object" get_status '{}' 2>/dev/null || true)"
		[ -n "$status" ] || continue
		ssid="$(printf '%s\n' "$status" | jsonfilter -e '@.ssid' 2>/dev/null || true)"
		bssid="$(printf '%s\n' "$status" | jsonfilter -e '@.bssid' 2>/dev/null || true)"
		interface="$(printf '%s\n' "$status" | jsonfilter -e '@.interface' 2>/dev/null || true)"
		[ -n "$interface" ] || interface="$(printf '%s\n' "$status" | jsonfilter -e '@.ifname' 2>/dev/null || true)"
		[ -n "$interface" ] || interface="${object#hostapd.}"
		case "$bssid" in
			[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
			*) continue;;
		esac
		json_add_object
		json_add_string ssid "$ssid"
		json_add_string bssid "$bssid"
		json_add_string interface "$interface"
		json_close_object
	done
	json_close_array
	json_dump
}

emit_configured_access_points() {
	local section mode ssid bssid macaddr ifname device disabled
	. /lib/functions.sh

	json_init
	json_add_array access_points
	append_configured_access_point() {
		section="$1"
		config_get mode "$section" mode ap
		case "$mode" in
			ap|ap-wds) ;;
			*) return 0;;
		esac
		config_get ssid "$section" ssid
		config_get bssid "$section" bssid
		config_get macaddr "$section" macaddr
		config_get ifname "$section" ifname
		config_get device "$section" device
		config_get_bool disabled "$section" disabled 0
		[ -n "$ssid" ] || [ -n "$bssid" ] || [ -n "$macaddr" ] || return 0
		json_add_object
		json_add_string section "$section"
		json_add_string ssid "$ssid"
		json_add_string bssid "${bssid:-$macaddr}"
		json_add_string interface "$ifname"
		json_add_string device "$device"
		json_add_boolean disabled "$disabled"
		json_close_object
	}
	config_load wireless
	config_foreach append_configured_access_point wifi-iface
	json_close_array
	json_dump
}

case "$1" in
list)
	json_init
	for method in status access_points configured_access_points restart disable regenerate_ca cleanup test logs; do json_add_object "$method"; json_close_object; done
	json_dump
	;;
call)
	case "$2" in
	status) emit_status;;
	access_points) emit_access_points;;
	configured_access_points) emit_configured_access_points;;
	restart)
		"$INIT" restart >/dev/null 2>&1
		sleep 1
		emit_status
		;;
	disable)
		uci -q set wloc.main.enabled='0'
		uci -q commit wloc
		"$RULES" cleanup
		"$INIT" stop >/dev/null 2>&1 || true
		emit_status
		;;
	regenerate_ca)
		"$RULES" cleanup
		"$INIT" stop >/dev/null 2>&1 || true
		rm -f /etc/wloc/ca.key /etc/wloc/ca.der \
			/etc/wloc/ca.pem /etc/wloc/ca.info.json \
			/www/wloc-ca.mobileconfig
		[ "$(uci -q get wloc.main.enabled || echo 0)" = 1 ] && "$INIT" start >/dev/null 2>&1
		sleep 1
		emit_status
		;;
	cleanup)
		"$RULES" cleanup
		emit_status
		;;
	test) emit_test;;
	logs)
		load_runtime_state
		json_init
		json_add_string logs "$runtime_log"
		json_dump
		;;
	*) echo '{"error":"unknown method"}'; exit 1;;
	esac
	;;
*) exit 1;;
esac
