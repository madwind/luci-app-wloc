{
  "luci-app-wloc": {
    "description": "Manage wloc",
    "read": {
      "ubus": {
        "luci.wloc": [ "status", "access_points", "configured_access_points", "test", "logs" ],
        "luci-rpc": [ "getDHCPLeases" ],
        "iwinfo": [ "devices", "info" ]
      },
      "uci": [ "wloc", "wireless" ]
    },
    "write": {
      "ubus": {
        "luci.wloc": [ "restart", "disable", "regenerate_ca", "cleanup" ]
      },
      "uci": [ "wloc" ]
    }
  }
}
