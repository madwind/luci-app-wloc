#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

RULES=/usr/libexec/wloc/rules.sh
START_ERROR=/var/run/wloc/start-error
client_count=0
client_error=''
client_macs=''

validate_client() {
	local section client_enabled name mac latitude longitude normalized proxy_type proxy_host proxy_port
	section="$1"
	config_get_bool client_enabled "$section" enabled 1
	[ "$client_enabled" -eq 1 ] || return 0
	config_get name "$section" name "$section"
	config_get mac "$section" mac
	config_get latitude "$section" latitude
	config_get longitude "$section" longitude
	config_get proxy_type "$section" proxy_type direct
	config_get proxy_host "$section" proxy_host
	config_get proxy_port "$section" proxy_port
	normalized="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
	[ -n "$mac" ] && [ -n "$latitude" ] && [ -n "$longitude" ] || {
		client_error="incomplete device rule: $name"; return 0;
	}
	case "$proxy_type" in
		direct) ;;
		http|socks5)
			[ -n "$proxy_host" ] && [ -n "$proxy_port" ] || {
				client_error="incomplete $proxy_type proxy for device rule: $name"; return 0;
			}
			case "$proxy_port" in
				*[!0-9]*|'') client_error="invalid proxy port for device rule: $name"; return 0;;
			esac
			[ "$proxy_port" -ge 1 ] 2>/dev/null && [ "$proxy_port" -le 65535 ] 2>/dev/null || {
				client_error="invalid proxy port for device rule: $name"; return 0;
			}
			;;
		*) client_error="invalid outbound type for device rule: $name"; return 0;;
	esac
	case " $client_macs " in
		*" $normalized "*) client_error="duplicate device MAC: $normalized"; return 0;;
	esac
	client_macs="$client_macs $normalized"
	client_count=$((client_count + 1))
}

append_client() {
	local section client_enabled name mac latitude longitude proxy_type proxy_host proxy_port
	section="$1"
	config_get_bool client_enabled "$section" enabled 1
	[ "$client_enabled" -eq 1 ] || return 0
	config_get name "$section" name "$section"
	config_get mac "$section" mac
	config_get latitude "$section" latitude
	config_get longitude "$section" longitude
	config_get proxy_type "$section" proxy_type direct
	config_get proxy_host "$section" proxy_host
	config_get proxy_port "$section" proxy_port
	mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
	procd_append_param command --client "$section" "$mac" "$latitude" "$longitude"
	procd_append_param command --client-name "$section" "$name"
	[ "$proxy_type" = direct ] || \
		procd_append_param command --client-proxy "$section" "$proxy_type" "$proxy_host" "$proxy_port"
}

listen_port_in_use() {
	local port
	port="$1"
	ss -H -ltn 2>/dev/null | awk -v port="$port" '
		$4 ~ (":" port "$") { found = 1; exit }
		END { exit !found }
	'
}

startup_failure() {
	local reason="$1"
	printf '%s\n' "$reason" >"$START_ERROR"
	logger -t wlocd "$reason"
	return 1
}

start_service() {
	mkdir -p /var/run/wloc
	rm -f /var/run/wloc/status.json /var/run/wloc/package.version "$START_ERROR"
	config_load wloc
	config_get_bool enabled main enabled 0
	config_get listen_port main listen_port 61520
	config_get_bool runtime_log main runtime_log 0

	"$RULES" cleanup
	[ "$enabled" -eq 1 ] || return 0
	case "$listen_port" in
		''|*[!0-9]*) startup_failure 'invalid local listen port; interception remains disabled'; return 1;;
	esac
	[ "$listen_port" -ge 1 ] 2>/dev/null && [ "$listen_port" -le 65535 ] 2>/dev/null || {
		startup_failure 'invalid local listen port; interception remains disabled'
		return $?
	}
	if listen_port_in_use "$listen_port"; then
		startup_failure "local listen port $listen_port is already in use; interception remains disabled"
		return $?
	fi

	client_count=0
	client_error=''
	client_macs=''
	config_foreach validate_client client
	[ -z "$client_error" ] || {
		startup_failure "$client_error; interception remains disabled"
		return $?
	}

	# Legacy 0.1.x configurations remain usable until the UI migrates them to
	# a MAC device rule.
	legacy=0
	if [ "$client_count" -eq 0 ]; then
		config_get target_ipv4 main target_ipv4
		config_get latitude main latitude
		config_get longitude main longitude
		[ -n "$target_ipv4" ] && [ -n "$latitude" ] && [ -n "$longitude" ] || {
			startup_failure 'no enabled device rules; interception remains disabled'
			return $?
		}
		legacy=1
	fi

	# Create empty short-lived selector sets. wlocd fills them only after its
	# transparent listener and CA are ready.
	"$RULES" apply "$listen_port" || {
		startup_failure 'runtime rules could not be applied; no safe prerouting priority was found'
		return $?
	}
	mkdir -p /etc/wloc
	chmod 0700 /etc/wloc

	procd_open_instance
	procd_set_param command /usr/sbin/wlocd --listen-port "$listen_port"
	[ "$runtime_log" -eq 1 ] && procd_append_param command --runtime-log
	if [ "$legacy" -eq 1 ]; then
		procd_append_param command --client-ip legacy "$target_ipv4" "$latitude" "$longitude"
	else
		config_foreach append_client client
	fi
	procd_set_param env WLOC_PROFILE_PATH=/www/wloc-ca.mobileconfig \
		WLOC_STATUS_PATH=/var/run/wloc/status.json \
		WLOC_START_ERROR_PATH="$START_ERROR"
	# Allow up to five minutes for NTP to establish a certificate-safe clock.
	procd_set_param respawn 3600 5 60
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wloc
	procd_close_instance
}

stop_service() {
	"$RULES" cleanup
}

service_stopped() {
	"$RULES" cleanup
	rm -f /var/run/wloc/status.json
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger wloc
}
