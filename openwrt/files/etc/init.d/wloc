#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

RULES=/usr/libexec/wloc/rules.sh
SCHEDULE=/usr/libexec/wloc/wifi-schedule.sh
START_ERROR=/var/run/wloc/start-error
rule_count=0
rule_error=''
wifi_sections=''

valid_mac() {
	local first_octet
	case "$1" in
		[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
		*) return 1;;
	esac
	first_octet="${1%%:*}"
	case "$first_octet" in [0-9A-Fa-f][13579BbDdFf]) return 1;; esac
	[ "$1" != '00:00:00:00:00:00' ]
}

collect_wifi() {
	wifi_sections="$wifi_sections $1"
}

validate_wifi() {
	local section enabled name bssid latitude longitude proxy_type proxy_host proxy_port
	section="$1"
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get name "$section" ssid "$section"
	config_get bssid "$section" bssid
	config_get latitude "$section" latitude
	config_get longitude "$section" longitude
	config_get proxy_type "$section" proxy_type direct
	config_get proxy_host "$section" proxy_host
	config_get proxy_port "$section" proxy_port
	bssid="$(printf '%s' "$bssid" | tr 'A-F' 'a-f')"

	[ -n "$latitude" ] && [ -n "$longitude" ] || {
		rule_error="incomplete location parameters for AP: $name"; return 0;
	}
	valid_mac "$bssid" || { rule_error="invalid BSSID for AP: $name"; return 0; }
	case "$proxy_type" in
		direct) ;;
		http|socks5)
			[ -n "$proxy_host" ] && [ -n "$proxy_port" ] || {
				rule_error="incomplete $proxy_type proxy for AP: $name"; return 0;
			}
			case "$proxy_port" in *[!0-9]*|'') rule_error="invalid proxy port for AP: $name"; return 0;; esac
			[ "$proxy_port" -ge 1 ] 2>/dev/null && [ "$proxy_port" -le 65535 ] 2>/dev/null || {
			rule_error="invalid proxy port for AP: $name"; return 0;
			}
			;;
		*) rule_error="invalid outbound type for AP: $name"; return 0;;
	esac
	rule_count=$((rule_count + 1))
}

append_rule_for_wifi() {
	local section enabled name latitude longitude proxy_type proxy_host proxy_port bssid
	section="$1"
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get name "$section" ssid "$section"
	config_get latitude "$section" latitude
	config_get longitude "$section" longitude
	config_get proxy_type "$section" proxy_type direct
	config_get proxy_host "$section" proxy_host
	config_get proxy_port "$section" proxy_port
	config_get bssid "$section" bssid
	bssid="$(printf '%s' "$bssid" | tr 'A-F' 'a-f')"
	procd_append_param command --rule "$section" "$bssid" "$latitude" "$longitude"
	procd_append_param command --rule-name "$section" "$name"
	[ "$proxy_type" = direct ] || \
		procd_append_param command --rule-proxy "$section" "$proxy_type" "$proxy_host" "$proxy_port"
}

listen_port_in_use() {
	local port
	port="$1"
	ss -H -ltn 2>/dev/null | awk -v port="$port" '
		$4 ~ (":" port "$") { found = 1; exit }
		END { exit !found }
	'
}

startup_failure() {
	local reason="$1"
	printf '%s\n' "$reason" >"$START_ERROR"
	logger -t wlocd "$reason"
	return 1
}

start_service() {
	mkdir -p /var/run/wloc
	rm -f /var/run/wloc/status.json /var/run/wloc/runtime.log \
		/var/run/wloc/package.version "$START_ERROR"
	# Restore optional user-authored tables. They are kept separate from the
	# runtime-owned inet/wloc table and a blank file is a valid no-op.
	ubus -S call luci.wloc firewall_apply '{}' >/dev/null 2>&1 || true
	config_load wloc

	# Keep WiFi/AP schedules independent from the WLOC interception daemon.
	# This also lets scheduled switching work when location interception is off.
	procd_open_instance
	procd_set_param command "$SCHEDULE" run
	procd_set_param respawn 3600 5 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wloc /etc/config/wireless
	procd_close_instance

	config_get_bool enabled main enabled 0
	config_get listen_port main listen_port 61520
	config_get_bool runtime_log main runtime_log 0

	"$RULES" cleanup
	[ "$enabled" -eq 1 ] || return 0
	case "$listen_port" in ''|*[!0-9]*) startup_failure 'invalid local listen port; interception remains disabled'; return 1;; esac
	[ "$listen_port" -ge 1 ] 2>/dev/null && [ "$listen_port" -le 65535 ] 2>/dev/null || {
		startup_failure 'invalid local listen port; interception remains disabled'; return $?;
	}
	if listen_port_in_use "$listen_port"; then
		startup_failure "local listen port $listen_port is already in use; interception remains disabled"; return $?;
	fi

	rule_count=0
	rule_error=''
	wifi_sections=''
	config_foreach collect_wifi wifi
	for wifi in $wifi_sections; do
		validate_wifi "$wifi"
		[ -z "$rule_error" ] || break
	done
	[ -z "$rule_error" ] || { startup_failure "$rule_error; interception remains disabled"; return $?; }
	[ "$rule_count" -gt 0 ] || { startup_failure 'no enabled rules; interception remains disabled'; return $?; }

	# Start with empty short-lived sets. wlocd arms them after its listener is ready.
	"$RULES" apply "$listen_port" || {
		startup_failure 'custom table inet wloc is missing or could not be initialized'; return $?;
	}
	mkdir -p /etc/wloc
	chmod 0700 /etc/wloc

	procd_open_instance
	procd_set_param command /usr/sbin/wlocd --listen-port "$listen_port"
	[ "$runtime_log" -eq 1 ] && procd_append_param command --runtime-log
	for wifi in $wifi_sections; do
		append_rule_for_wifi "$wifi"
	done
	procd_set_param env WLOC_PROFILE_PATH=/www/wloc-ca.mobileconfig \
		WLOC_STATUS_PATH=/var/run/wloc/status.json \
		WLOC_RUNTIME_LOG_PATH=/var/run/wloc/runtime.log \
		WLOC_START_ERROR_PATH="$START_ERROR"
	procd_set_param respawn 3600 5 60
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wloc
	procd_close_instance
}

stop_service() {
	"$SCHEDULE" stop >/dev/null 2>&1 || true
	"$RULES" cleanup
}

service_stopped() {
	"$SCHEDULE" stop >/dev/null 2>&1 || true
	"$RULES" cleanup
	rm -f /var/run/wloc/status.json /var/run/wloc/runtime.log
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger wloc
}
