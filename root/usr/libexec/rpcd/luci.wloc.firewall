#!/bin/sh

. "${WLOC_JSHN_PATH:-/usr/share/libubox/jshn.sh}"

FIREWALL=${WLOC_FIREWALL_PATH:-/etc/wloc/firewall.nft}
FIREWALL_HELPER=${WLOC_FIREWALL_HELPER_PATH:-/usr/libexec/wloc/firewall.sh}
GEO_COMPILER=${WLOC_FIREWALL_GEO_COMPILER:-/usr/libexec/wloc/firewall-geo.lua}
SOURCE_RUNTIME=${WLOC_FIREWALL_SOURCE_RUNTIME:-/var/run/wloc/firewall.applied.source.nft}
WARNINGS=${WLOC_FIREWALL_WARNINGS_PATH:-/var/run/wloc/firewall.warnings}
RECOVERING=${WLOC_FIREWALL_RECOVERING_PATH:-/var/run/wloc/firewall.recovering}
RUNTIME_WARNING=${WLOC_FIREWALL_RUNTIME_WARNING_PATH:-/var/run/wloc/firewall.runtime-warning}
RUNTIME_DIR=${WLOC_RUNTIME_DIR:-/var/run/wloc}

json_error() {
    json_init
    json_add_boolean ok 0
    json_add_string error "$1"
    [ -z "${2:-}" ] || json_add_string detail "$2"
    json_dump
}

add_warnings() {
    json_add_array warnings
    if [ -r "$WARNINGS" ]; then
        while IFS= read -r warning; do
            [ -z "$warning" ] || json_add_string '' "$warning"
        done <"$WARNINGS"
    fi
    json_close_array
}

read_request() {
    local request
    request="$(cat)"
    json_load "$request" 2>/dev/null || return 1
    json_get_var firewall_config config
    [ "${#firewall_config}" -le 1048576 ]
}

fold_active() {
    local active="$1" source="$2" active_file folded
    [ -n "$active" ] || return 0
    [ -r "$source" ] || { printf '%s' "$active"; return 0; }
    mkdir -p "$RUNTIME_DIR" || { printf '%s' "$active"; return 0; }
    active_file="$(mktemp "$RUNTIME_DIR/firewall-active.XXXXXX")" || { printf '%s' "$active"; return 0; }
    printf '%s\n' "$active" >"$active_file"
    folded="$(lua "$GEO_COMPILER" fold "$source" "$active_file" 2>/dev/null || true)"
    rm -f "$active_file"
    [ -n "$folded" ] && printf '%s' "$folded" || printf '%s' "$active"
}

emit_read() {
    local config active source folded recovering warning
    config="$(cat "$FIREWALL" 2>/dev/null || true)"
    active="$("$FIREWALL_HELPER" active 2>/dev/null || true)"
    source="$SOURCE_RUNTIME"
    [ -r "$source" ] || source="$FIREWALL"
    folded="$(fold_active "$active" "$source")"
    recovering="$(cat "$RECOVERING" 2>/dev/null || echo 0)"
    warning="$(cat "$RUNTIME_WARNING" 2>/dev/null || true)"
    case "$recovering" in 1|true|yes) recovering=1;; *) recovering=0;; esac

    json_init
    json_add_boolean ok 1
    json_add_string path "$FIREWALL"
    json_add_string config "$config"
    json_add_string active "${folded:-# No WLOC nftables tables are active.}"
    [ -n "$active" ] && json_add_boolean active_found 1 || json_add_boolean active_found 0
    json_add_boolean recovering "$recovering"
    json_add_string warning "$warning"
    add_warnings
    json_dump
}

validate_config() {
    local source detail
    mkdir -p "$RUNTIME_DIR" || return 1
    source="$(mktemp "$RUNTIME_DIR/firewall-source.XXXXXX")" || return 1
    printf '%s' "$firewall_config" >"$source" || { rm -f "$source"; return 1; }
    if detail="$("$FIREWALL_HELPER" validate "$source" 2>&1)"; then
        rm -f "$source"
        return 0
    fi
    rm -f "$source"
    firewall_detail="$detail"
    return 1
}

emit_validate() {
    firewall_detail=''
    if validate_config; then
        json_init
        json_add_boolean ok 1
        json_add_boolean valid 1
        add_warnings
        json_dump
    else
        json_init
        json_add_boolean ok 0
        json_add_boolean valid 0
        json_add_string error 'nftables syntax check failed'
        json_add_string detail "${firewall_detail:-validation failed}"
        add_warnings
        json_dump
    fi
}

emit_apply() {
    local source detail
    mkdir -p "$RUNTIME_DIR" || { json_error 'Unable to create the WLOC runtime directory.'; return; }
    source="$(mktemp "$RUNTIME_DIR/firewall-apply-source.XXXXXX")" || { json_error 'Unable to stage Firewall rules.'; return; }
    printf '%s' "$firewall_config" >"$source" || { rm -f "$source"; json_error 'Unable to stage Firewall rules.'; return; }
    if ! detail="$("$FIREWALL_HELPER" apply "$source" 2>&1)"; then
        rm -f "$source"
        json_error 'The nftables transaction failed.' "${detail:-apply failed}"
        return
    fi
    rm -f "$source"
    emit_read
}

emit_save() {
    local directory temporary
    firewall_detail=''
    if ! validate_config; then
        json_error 'The Firewall file could not be saved.' "${firewall_detail:-validation failed}"
        return
    fi
    directory="${FIREWALL%/*}"
    [ "$directory" = "$FIREWALL" ] && directory='.'
    mkdir -p "$directory" || { json_error 'The Firewall file could not be saved.' 'cannot create destination directory'; return; }
    temporary="$(mktemp "${FIREWALL}.XXXXXX")" || { json_error 'The Firewall file could not be saved.' 'cannot create temporary file'; return; }
    if ! printf '%s' "$firewall_config" >"$temporary" || ! chmod 0600 "$temporary" || ! mv -f "$temporary" "$FIREWALL"; then
        rm -f "$temporary"
        json_error 'The Firewall file could not be saved.' 'atomic file replacement failed'
        return
    fi
    emit_read
}

case "$1" in
list)
    printf '%s\n' '{"read":{},"validate":{"config":""},"apply":{"config":""},"save":{"config":""}}'
    ;;
call)
    case "$2" in
        read) emit_read;;
        validate)
            read_request || { json_error 'invalid request'; exit 0; }
            emit_validate
            ;;
        apply)
            read_request || { json_error 'invalid request'; exit 0; }
            emit_apply
            ;;
        save)
            read_request || { json_error 'invalid request'; exit 0; }
            emit_save
            ;;
        *) json_error 'unknown method'; exit 1;;
    esac
    ;;
*) exit 1;;
esac
