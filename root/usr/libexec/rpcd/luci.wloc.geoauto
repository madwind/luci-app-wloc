#!/bin/sh

. /usr/share/libubox/jshn.sh

AUTO=/usr/libexec/wloc/geo-auto.sh

read_request() {
    local raw
    raw="$(cat)"
    json_load "${raw:-{}}" 2>/dev/null || json_init
}

case "$1" in
list)
    printf '%s\n' '{"status":{},"set_auto":{"enabled":0}}'
    ;;
call)
    case "$2" in
        status) exec "$AUTO" status;;
        set_auto)
            read_request
            json_get_var enabled enabled
            exec "$AUTO" set "$enabled"
            ;;
        *) printf '%s\n' '{"ok":false,"error":"unknown method"}'; exit 1;;
    esac
    ;;
*) exit 1;;
esac
