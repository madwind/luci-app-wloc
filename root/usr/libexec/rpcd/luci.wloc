#!/bin/sh

. /usr/share/libubox/jshn.sh

json_value() (
	local data="$1"
	local key="$2"
	local value

	[ -n "$data" ] || return 1
	json_load "$data" 2>/dev/null || return 1
	json_get_var value "$key"

	printf '%s' "$value"
)

INIT=/etc/init.d/wloc
RULES=/usr/libexec/wloc/rules.sh
STATE=/var/run/wloc/status.json
RUNTIME_LOG=/var/run/wloc/runtime.log
CAINFO=/etc/wloc/ca.info.json
VERSION_CACHE=/var/run/wloc/package.version
FIREWALL=/etc/wloc/firewall.nft
FIREWALL_RUNTIME=/var/run/wloc/firewall.applied.nft
AP_LIB=${WLOC_AP_LIB_PATH:-/usr/libexec/wloc/ap-lib.sh}

firewall_tables() {
	awk '
		$1 == "table" {
			if ($2 !~ /^(ip|ip6|inet|arp|bridge|netdev)$/ || $3 !~ /^[A-Za-z0-9_.-]+$/) exit 2
			print $2, $3
		}
	' "$1"
}

firewall_response() {
	local active family name table_count active_count table_dump
	active=''
	table_count=0
	active_count=0
	while read -r family name; do
		[ -n "$family" ] || continue
		table_count=$((table_count + 1))
		if table_dump="$(nft list table "$family" "$name" 2>/dev/null)"; then
			active_count=$((active_count + 1))
			active="${active}${active:+

}${table_dump}"
		fi
	done <<EOF
$(firewall_tables "$FIREWALL" 2>/dev/null || true)
EOF
	json_init
	json_add_boolean ok 1
	json_add_string path "$FIREWALL"
	json_add_string config "$(cat "$FIREWALL" 2>/dev/null || true)"
	json_add_string active "${active:-# No custom nftables tables are active.}"
	[ "$table_count" -eq "$active_count" ] && json_add_boolean active_found 1 || json_add_boolean active_found 0
	json_add_int table_count "$table_count"
	json_add_int active_table_count "$active_count"
	json_dump
}

firewall_request_config() {
	local request
	request="$(cat)"
	json_load "$request" 2>/dev/null || return 1
	json_get_var firewall_config config
	[ "${#firewall_config}" -le 1048576 ]
}

firewall_validate_file() {
	local source="$1" check detail rc family name tables
	if grep -Eq '^[[:space:]]*(flush|add|delete|destroy|insert|replace|reset|include|define|redefine|undefine)([[:space:]]|$)' "$source"; then
		firewall_error='Only top-level table declarations are allowed.'
		return 1
	fi
	tables="$(firewall_tables "$source")" || {
		firewall_error='A table family or name is not supported by this editor.'
		return 1
	}
	check="$(mktemp /var/run/wloc/firewall-check.XXXXXX)" || return 1
	: >"$check"
	while read -r family name; do
		[ -n "$family" ] || continue
		nft list table "$family" "$name" >/dev/null 2>&1 && printf 'delete table %s %s\n' "$family" "$name" >>"$check"
	done <<EOF
$tables
EOF
	cat "$source" >>"$check"
	detail="$(nft --check --file "$check" 2>&1)" && rc=0 || rc=$?
	rm -f "$check"
	[ "$rc" -eq 0 ] || {
		firewall_error="${detail:-nftables syntax check failed}"
		return 1
	}
}

emit_firewall_validate() {
	local source
	mkdir -p /var/run/wloc
	source="$(mktemp /var/run/wloc/firewall-source.XXXXXX)" || exit 1
	printf '%s' "$firewall_config" >"$source"
	if firewall_validate_file "$source"; then
		json_init; json_add_boolean ok 1; json_add_boolean valid 1; json_dump
	else
		json_init; json_add_boolean ok 0; json_add_boolean valid 0
		json_add_string error 'nftables syntax check failed'
		json_add_string detail "$firewall_error"; json_dump
	fi
	rm -f "$source"
}

emit_firewall_save() {
	local source saved
	mkdir -p /var/run/wloc /etc/wloc
	source="$(mktemp /var/run/wloc/firewall-source.XXXXXX)" || exit 1
	printf '%s' "$firewall_config" >"$source"
	if ! firewall_validate_file "$source"; then
		json_init; json_add_boolean ok 0; json_add_boolean valid 0
		json_add_string error 'nftables syntax check failed'
		json_add_string detail "$firewall_error"; json_dump
		rm -f "$source"
		return
	fi
	saved="$(mktemp /etc/wloc/firewall.nft.XXXXXX)" || { rm -f "$source"; exit 1; }
	chmod 0600 "$saved"
	cat "$source" >"$saved" && mv -f "$saved" "$FIREWALL"
	rm -f "$source"
	json_init; json_add_boolean ok 1; json_add_boolean valid 1
	json_add_string path "$FIREWALL"; json_dump
}

emit_firewall_apply() {
	local transaction detail rc family name tables refresh_detail runtime_tmp
	mkdir -p /var/run/wloc
	transaction="$(mktemp /var/run/wloc/firewall-apply.XXXXXX)" || exit 1
	: >"$transaction"
	tables="$( { firewall_tables "$FIREWALL_RUNTIME" 2>/dev/null || true; firewall_tables "$FIREWALL" 2>/dev/null || true; } | awk '!seen[$0]++')"
	while read -r family name; do
		[ -n "$family" ] || continue
		nft list table "$family" "$name" >/dev/null 2>&1 && printf 'delete table %s %s\n' "$family" "$name" >>"$transaction"
	done <<EOF
$tables
EOF
	cat "$FIREWALL" >>"$transaction"
	detail="$(nft --file "$transaction" 2>&1)" && rc=0 || rc=$?
	rm -f "$transaction"
	if [ "$rc" -ne 0 ]; then
		json_init; json_add_boolean ok 0
		json_add_string error 'Failed to apply nftables rules.'
		json_add_string detail "$detail"; json_dump
		return
	fi
	runtime_tmp="$(mktemp /var/run/wloc/firewall-applied.XXXXXX)" || exit 1
	cp "$FIREWALL" "$runtime_tmp"
	chmod 0600 "$runtime_tmp"
	mv -f "$runtime_tmp" "$FIREWALL_RUNTIME"
	if ! refresh_detail="$("$RULES" refresh-hosts 2>&1)"; then
		json_init; json_add_boolean ok 0
		json_add_string error 'Custom tables were applied, but Apple WLOC addresses could not be refreshed.'
		json_add_string detail "$refresh_detail"; json_dump
		return
	fi
	firewall_response
}

load_runtime_state() {
	armed=0
	configured_aps=0
	ca_fingerprint=''
	accepted_connections=0
	passthrough_connections=0
	tls_intercepted=0
	wloc_requests=0
	patched_responses=0
	delivered_responses=0
	patch_failures=0
	last_event=''
	last_error=''
	service_reason=''
	session_started_at=0
	updated_at=0
	runtime_log_enabled=0
	runtime_log_revision=0
	activity_rows=''

	[ -s "$STATE" ] || return 0
	json_load_file "$STATE" 2>/dev/null || return 0
	json_get_vars armed:0 configured_aps:0 ca_fingerprint \
		accepted_connections:0 passthrough_connections:0 tls_intercepted:0 \
		wloc_requests:0 patched_responses:0 delivered_responses:0 patch_failures:0 \
		last_event last_error session_started_at:0 updated_at:0 \
		runtime_log_enabled:0 runtime_log_revision:0
	if json_select ap_activity 2>/dev/null; then
		json_get_keys activity_keys
		for activity_index in $activity_keys; do
			json_select "$activity_index" || continue
			activity_error=''
			json_get_vars ap_id latitude longitude last_location_at:0 success:0
			json_get_var activity_error last_error
			case "$ap_id" in ''|*[!A-Za-z0-9_-]*) ap_id='';; esac
			[ -n "$ap_id" ] && activity_rows="${activity_rows}${ap_id} ${latitude:-0} ${longitude:-0} ${last_location_at:-0} ${success:-0} ${activity_error:-}
"
			json_select ..
		done
		json_select ..
	fi
}

package_version() {
	local version
	version="$(cat "$VERSION_CACHE" 2>/dev/null || true)"
	case "$version" in ''|*[!A-Za-z0-9._+~-]*)
		version="$(apk list --installed luci-app-wloc 2>/dev/null \
			| sed -n 's/^luci-app-wloc-\([^ ]*\).*/\1/p' | head -n 1)"
		case "$version" in *[!A-Za-z0-9._+~-]*) version='';; esac
		[ -z "$version" ] || printf '%s\n' "$version" >"$VERSION_CACHE"
		;;
	esac
	printf '%s' "$version"
}

emit_status() {
	local configured enabled version table_dump rules_present attempts intercepted counters conflict order_conflict prerouting_priority detected_priorities daemon_running service_reason
	load_runtime_state
	configured=0
	uci -q show wloc | grep -q '=wifi$' && configured=1
	enabled="$(uci -q get wloc.main.enabled 2>/dev/null || echo 0)"
	case "$enabled" in 1) enabled=1;; *) enabled=0;; esac
	version="$(package_version)"
	table_dump="$(nft list table inet wloc 2>/dev/null)" && rules_present=1 || rules_present=0
	counters="$(printf '%s\n' "$table_dump" | awk '
		/wloc owned (AP|ingress) redirect/ {
			if (match($0, /counter packets [0-9]+/)) {
				value = substr($0, RSTART + 16, RLENGTH - 16)
				attempts += value
				intercepted += value
			}
		}
		END { print attempts + 0, intercepted + 0 }')"
	attempts="${counters%% *}"
	intercepted="${counters#* }"
	case "$attempts" in ''|*[!0-9]*) attempts=0;; esac
	case "$intercepted" in ''|*[!0-9]*) intercepted=0;; esac
	conflict=0
	[ "$attempts" -gt 0 ] && [ "$accepted_connections" -eq 0 ] && conflict=1
	order_conflict="$(cat /var/run/wloc/order-conflict 2>/dev/null || true)"
	case "$order_conflict" in 1|unknown) conflict=1;; esac
	prerouting_priority="$(cat /var/run/wloc/prerouting.priority 2>/dev/null || true)"
	case "$prerouting_priority" in -[0-9]*|[0-9]*) :;; *) prerouting_priority='';; esac
	detected_priorities="$(cat /var/run/wloc/prerouting.details 2>/dev/null || true)"
	service_reason="$(cat /var/run/wloc/start-error 2>/dev/null || true)"
	daemon_running=0
	pidof wlocd >/dev/null 2>&1 && daemon_running=1
	if [ "$daemon_running" -eq 0 ] && [ "$enabled" -eq 1 ] && [ -z "$service_reason" ]; then
		service_reason='service is not running; check the system log'
	fi
	if [ "$daemon_running" -eq 1 ] && [ "$armed" -eq 0 ]; then
		case "$last_event" in
			lease_failed)
				service_reason='runtime rule refresh failed; interception is disabled'
				[ -z "$last_error" ] || service_reason="$service_reason: $last_error"
				;;
			esac
	elif [ "$daemon_running" -eq 1 ] && [ "$rules_present" -eq 0 ]; then
		service_reason='runtime interception rules are missing'
	elif [ "$daemon_running" -eq 1 ] && [ "$conflict" -eq 1 ]; then
		service_reason='transparent-proxy rule order conflict; see the runtime log'
	fi
	if [ -z "$ca_fingerprint" ] && [ -s "$CAINFO" ]; then
		json_load_file "$CAINFO" 2>/dev/null && json_get_var ca_fingerprint fingerprint_sha256
	fi

	json_init
	json_add_boolean configured "$configured"
	json_add_boolean enabled "$enabled"
	json_add_string version "$version"
	json_add_boolean running "$daemon_running"
	json_add_boolean rules_present "$rules_present"
	json_add_boolean armed "$armed"
	json_add_int configured_aps "$configured_aps"
	json_add_int accepted_connections "$accepted_connections"
	json_add_int passthrough_connections "$passthrough_connections"
	json_add_int tls_intercepted "$tls_intercepted"
	json_add_int wloc_requests "$wloc_requests"
	json_add_int patched_responses "$patched_responses"
	json_add_int delivered_responses "$delivered_responses"
	json_add_int patch_failures "$patch_failures"
	json_add_string last_event "$last_event"
	json_add_string last_error "$last_error"
	json_add_string service_reason "$service_reason"
	json_add_int session_started_at "$session_started_at"
	json_add_int updated_at "$updated_at"
	json_add_boolean runtime_log_enabled "$runtime_log_enabled"
	json_add_int runtime_log_revision "$runtime_log_revision"
	json_add_int interception_attempts "$attempts"
	json_add_int intercepted_packets "$intercepted"
	json_add_boolean path_conflict "$conflict"
	json_add_boolean order_conflict "$([ "$order_conflict" = 1 ] && echo 1 || echo 0)"
	json_add_string order_state "${order_conflict:-missing}"
	json_add_string prerouting_priority "$prerouting_priority"
	json_add_string detected_priorities "$detected_priorities"
	json_add_string fingerprint "$ca_fingerprint"
	json_add_string profile_url '/wloc-ca.mobileconfig'
	json_add_array ap_activity
	while read -r ap_id activity_lat activity_lon activity_at activity_success activity_error; do
		[ -n "$ap_id" ] || continue
		case "$activity_at" in ''|*[!0-9]*) activity_at=0;; esac
		case "$activity_success" in 1|true) activity_success=1;; *) activity_success=0;; esac
		json_add_object
		json_add_string ap_id "$ap_id"
		json_add_string latitude "$activity_lat"
		json_add_string longitude "$activity_lon"
		json_add_int last_location_at "$activity_at"
		json_add_boolean success "$activity_success"
		json_add_string last_error "$activity_error"
		json_close_object
	done <<EOF
$activity_rows
EOF
	json_close_array
	json_dump
}

WIRELESS_RUNTIME=/var/run/wloc/rpc-wireless-runtime.$$

load_wireless_runtime() {
	local status radio index section ifname radio_keys interface_keys hostapd_status bssid ssid
	mkdir -p /var/run/wloc
	: >"$WIRELESS_RUNTIME"
	status="$(ubus -S -t 3 call network.wireless status 2>/dev/null || true)"
	[ -n "$status" ] || return 0
	json_load "$status" 2>/dev/null || return 0
	radio_keys=''
	json_get_keys radio_keys
	for radio in $radio_keys; do
		json_select "$radio" || continue
		json_select interfaces || { json_select ..; continue; }
		interface_keys=''
		json_get_keys interface_keys
		for index in $interface_keys; do
			json_select "$index" || continue
			section=''
			ifname=''
			json_get_var section section
			json_get_var ifname ifname
			case "$section:$ifname" in
				''|*:|:*|*[!A-Za-z0-9_.:-]*) ;;
				*)
					hostapd_status="$(ubus -S -t 3 call "hostapd.$ifname" get_status '{}' 2>/dev/null || true)"
					[ -n "$hostapd_status" ] || { json_select ..; continue; }
					bssid="$(json_value "$hostapd_status" bssid || true)"
					ssid="$(json_value "$hostapd_status" ssid || true)"
					printf '%s|%s|%s|%s|%s\n' "$section" "$radio" "$ifname" "$bssid" "$ssid" >>"$WIRELESS_RUNTIME"
					;;
			esac
			json_select ..
		done
		json_select ..
		json_select ..
	done
}

runtime_for_section() {
	local wanted="$1" runtime_section runtime_radio runtime_ifname runtime_bssid runtime_ssid
	runtime_radio=''
	runtime_ifname=''
	runtime_bssid=''
	runtime_ssid=''
	while IFS='|' read -r runtime_section runtime_radio runtime_ifname runtime_bssid runtime_ssid; do
		[ "$runtime_section" = "$wanted" ] || continue
		printf '%s|%s|%s|%s\n' "$runtime_radio" "$runtime_ifname" "$runtime_bssid" "$runtime_ssid"
		return 0
	done <"$WIRELESS_RUNTIME"
}

emit_configured_access_points() {
	local section mode ssid network device mapping_error disabled runtime active radio ifname bssid runtime_ssid
	local unique ambiguous
	. /lib/functions.sh
	. "$AP_LIB"
	load_wireless_runtime
	SSID_INVENTORY=/var/run/wloc/rpc-wireless-ssids.$$
	: >"$SSID_INVENTORY"
	collect_configured_ssid() {
		local candidate_mode candidate_ssid
		candidate_mode=''
		candidate_ssid=''
		config_get candidate_mode "$1" mode ap
		case "$candidate_mode" in
			ap|ap-wds) ;;
			*) return 0;;
		esac
		config_get candidate_ssid "$1" ssid ''
		[ -n "$candidate_ssid" ] && printf '%s\n' "$candidate_ssid" >>"$SSID_INVENTORY"
	}
	ssid_is_ambiguous() {
		[ "$(grep -F -x -c -- "$1" "$SSID_INVENTORY" 2>/dev/null || true)" -gt 1 ]
	}

	json_init
	json_add_array access_points
	append_configured_access_point() {
		section="$1"
		config_get mode "$section" mode ap
		case "$mode" in
			ap|ap-wds) ;;
			*) return 0;;
		esac
		config_get ssid "$section" ssid ''
		config_get network "$section" network ''
		config_get_bool disabled "$section" disabled 0
		device=''
		mapping_error=''
		if [ -z "$ssid" ]; then
			mapping_error='SSID is empty'
		elif ssid_is_ambiguous "$ssid"; then
			mapping_error="SSID \"$ssid\" is used by multiple APs and cannot be selected by WLOC."
		fi
		if [ -z "$network" ]; then
			mapping_error='network is not configured'
		else
			device="$(wloc_ap_get_network_device "$network" 2>/dev/null || true)"
			[ -n "$device" ] || mapping_error='network device unavailable'
		fi
		interface=''
		radio=''
		bssid=''
		runtime_ssid=''
		runtime="$(runtime_for_section "$section")"
		if [ -n "$runtime" ]; then
			radio="${runtime%%|*}"
			runtime="${runtime#*|}"
			interface="${runtime%%|*}"
			runtime="${runtime#*|}"
			bssid="${runtime%%|*}"
			runtime_ssid="${runtime#*|}"
			active=1
		else
			active=0
		fi
		if [ -z "$ssid" ]; then unique=0; else unique=1; fi
		if ssid_is_ambiguous "$ssid"; then unique=0; ambiguous=1; else ambiguous=0; fi
		json_add_object
		json_add_string section "$section"
		json_add_string ssid "$ssid"
		json_add_string network "$network"
		json_add_string device "$device"
		json_add_string mapping_error "$mapping_error"
		json_add_boolean unique "$unique"
		json_add_boolean ambiguous "$ambiguous"
		json_add_boolean disabled "$disabled"
		json_add_boolean active "$active"
		json_add_boolean up "$active"
		json_add_string radio "$radio"
		json_add_string ifname "$interface"
		json_add_string bssid "$bssid"
		json_close_object
	}
	config_load wireless
	config_foreach collect_configured_ssid wifi-iface
	config_foreach append_configured_access_point wifi-iface
	json_close_array
	json_dump
	rm -f "$WIRELESS_RUNTIME" "$SSID_INVENTORY"
}

case "$1" in
list)
	json_init
	for method in status configured_access_points restart disable regenerate_ca cleanup logs firewall_read firewall_validate firewall_save firewall_apply; do
		json_add_object "$method"
		case "$method" in firewall_validate|firewall_save) json_add_string config '';; esac
		json_close_object
	done
	json_dump
	;;
call)
	case "$2" in
	status) emit_status;;
	configured_access_points) emit_configured_access_points;;
	restart)
		"$INIT" restart >/dev/null 2>&1
		sleep 1
		emit_status
		;;
	disable)
		uci -q set wloc.main.enabled='0'
		uci -q commit wloc
		"$RULES" cleanup
		"$INIT" stop >/dev/null 2>&1 || true
		emit_status
		;;
	regenerate_ca)
		"$RULES" cleanup
		"$INIT" stop >/dev/null 2>&1 || true
		rm -f /etc/wloc/ca.key /etc/wloc/ca.der \
			/etc/wloc/ca.pem /etc/wloc/ca.info.json \
			/www/wloc-ca.mobileconfig
		[ "$(uci -q get wloc.main.enabled || echo 0)" = 1 ] && "$INIT" start >/dev/null 2>&1
		sleep 1
		emit_status
		;;
	cleanup)
		"$RULES" cleanup
		emit_status
		;;
	logs)
		load_runtime_state
		json_init
		if [ "$runtime_log_enabled" -eq 1 ]; then
			json_add_string logs "$(cat "$RUNTIME_LOG" 2>/dev/null || true)"
		else
			json_add_string logs ''
		fi
		json_dump
		;;
	firewall_read) firewall_response;;
	firewall_validate)
		firewall_request_config || { echo '{"ok":false,"valid":false,"error":"invalid request"}'; exit 0; }
		emit_firewall_validate
		;;
	firewall_save)
		firewall_request_config || { echo '{"ok":false,"valid":false,"error":"invalid request"}'; exit 0; }
		emit_firewall_save
		;;
	firewall_apply) emit_firewall_apply;;
	*) echo '{"error":"unknown method"}'; exit 1;;
	esac
	;;
*) exit 1;;
esac
