#!/bin/sh

. "${WLOC_JSHN_PATH:-/usr/share/libubox/jshn.sh}"

INIT=${WLOC_INIT_PATH:-/etc/init.d/wloc}

emit_error() {
    json_init
    json_add_boolean ok 0
    json_add_string error "$1"
    json_dump
}

emit_ok() {
    json_init
    json_add_boolean ok 1
    json_add_string state "$1"
    json_dump
}

service_enabled() {
    [ "$(uci -q get wloc.main.enabled 2>/dev/null || true)" = 1 ]
}

run_action() {
    local action="$1"

    case "$action" in
        start|restart)
            service_enabled || {
                emit_error 'Enable service in Settings before starting WLOC.'
                return 0
            }
            ;;
        stop) ;;
        *)
            emit_error 'Unsupported WLOC service action.'
            return 0
            ;;
    esac

    if "$INIT" "$action" >/dev/null 2>&1; then
        case "$action" in
            start) emit_ok starting;;
            stop) emit_ok stopping;;
            restart) emit_ok restarting;;
        esac
    else
        emit_error "Unable to $action the WLOC service."
    fi
}

case "$1" in
list)
    json_init
    for method in start stop restart; do
        json_add_object "$method"
        json_close_object
    done
    json_dump
    ;;
call)
    case "$2" in
        start|stop|restart) run_action "$2";;
        *) emit_error 'Unknown WLOC service method.';;
    esac
    ;;
*)
    exit 1
    ;;
esac
