table bridge wloc {
    set target_ingress_interfaces {
        type ifname
        flags timeout
    }

    chain mark_prerouting {
        type filter hook prerouting priority dstnat - 1;
        policy accept;

        iifname @target_ingress_interfaces meta l4proto { tcp, udp } counter meta mark set meta mark | 0x80000000 comment "wloc ingress"
    }
}

table inet wloc {
    set bypass_v4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { %geoip:private% }
    }

    chain transparent_prerouting {
        type filter hook prerouting priority mangle - 2;
        policy accept;

        meta mark & 0x80000000 == 0 return
        ct direction reply return
        meta mark & 0x00010000 != 0 return
        meta nfproto != ipv4 return

        meta l4proto { tcp, udp } th dport 53 ct mark set ct mark | 0x00010000 meta mark set meta mark | 0x40010000 counter tproxy to :61520 accept comment "wloc dns"

        fib daddr type local return
        ip daddr @bypass_v4 return

        meta l4proto { tcp, udp } ct mark set ct mark | 0x00010000 meta mark set meta mark | 0x40010000 counter tproxy to :61520 accept comment "wloc traffic"
    }

    chain clear_ingress_mark {
        type filter hook prerouting priority dstnat + 1;
        policy accept;

        meta mark & 0x80000000 != 0 meta mark set meta mark & 0x7fffffff comment "wloc clear ingress mark"
    }
}
