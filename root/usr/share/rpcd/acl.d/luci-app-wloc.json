{
  "luci-app-wloc": {
    "description": "Manage wloc",
    "read": {
      "ubus": {
        "luci.wloc": [ "status", "configured_access_points", "logs", "firewall_read", "firewall_validate" ]
      },
      "uci": [ "wloc", "wireless" ]
    },
    "write": {
      "ubus": {
        "luci.wloc": [ "restart", "disable", "regenerate_ca", "cleanup", "firewall_save", "firewall_apply" ]
      },
      "uci": [ "wloc" ]
    }
  }
}
