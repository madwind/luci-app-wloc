{
  "luci-app-wloc": {
    "description": "Manage wloc",
    "read": {
      "ubus": {
        "log": [ ":subscribe" ],
        "luci.wloc": [ "status", "configured_access_points" ],
        "luci.wloc.defaults": [ "firewall" ],
        "luci.wloc.firewall": [ "read", "validate" ],
        "luci.wloc.geo": [ "status", "check" ],
        "luci.wloc.geoauto": [ "status" ],
        "luci.wloc.routing": [ "read", "validate" ],
        "luci.wloc.update": [ "status" ]
      },
      "uci": [ "wloc", "wireless" ]
    },
    "write": {
      "ubus": {
        "luci.wloc": [ "restart", "regenerate_ca" ],
        "luci.wloc.firewall": [ "save", "apply" ],
        "luci.wloc.geo": [ "update", "stop" ],
        "luci.wloc.geoauto": [ "set_auto" ],
        "luci.wloc.routing": [ "save", "apply" ],
        "luci.wloc.update": [ "check", "install", "stop" ]
      },
      "uci": [ "wloc" ]
    }
  }
}
