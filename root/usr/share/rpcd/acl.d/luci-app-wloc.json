{
  "luci-app-wloc": {
    "description": "Manage wloc",
    "read": {
      "ubus": {
        "log": [ ":subscribe" ],
        "luci.wloc": [ "status", "configured_access_points", "firewall_read", "firewall_validate" ],
        "luci.wloc.update": [ "status" ]
      },
      "uci": [ "wloc", "wireless" ]
    },
    "write": {
      "ubus": {
        "luci.wloc": [ "restart", "regenerate_ca", "firewall_save", "firewall_apply" ],
        "luci.wloc.update": [ "check", "install", "stop" ]
      },
      "uci": [ "wloc" ]
    }
  }
}
