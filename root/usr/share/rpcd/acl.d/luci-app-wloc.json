{
  "luci-app-wloc": {
    "description": "Manage wloc",
    "read": {
      "ubus": {
        "log": [ "read", ":subscribe" ],
        "luci.wloc": [ "status", "configured_access_points" ],
        "luci.wloc.defaults": [ "firewall", "routing" ],
        "luci.wloc.firewall": [ "read", "ready", "runtime", "validate" ],
        "luci.wloc.routing": [ "read", "runtime", "validate" ]
      },
      "uci": [ "wloc", "wireless" ]
    },
    "write": {
      "ubus": {
        "luci.wloc": [ "regenerate_ca" ],
        "luci.wloc.service": [ "start", "stop", "restart" ],
        "luci.wloc.firewall": [ "save", "apply" ],
        "luci.wloc.routing": [ "save", "apply" ]
      },
      "uci": [ "wloc" ]
    }
  }
}
