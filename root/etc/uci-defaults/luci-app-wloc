#!/bin/sh

uci -q get wloc.main >/dev/null || uci -q set wloc.main=wloc
uci -q get wloc.main.enabled >/dev/null || uci -q set wloc.main.enabled='0'
uci -q get wloc.main.listen_port >/dev/null || uci -q set wloc.main.listen_port='61520'
uci -q get wloc.main.debug >/dev/null || uci -q set wloc.main.debug='0'
uci -q get wloc.main.geoip_file >/dev/null || uci -q set wloc.main.geoip_file='/usr/share/xray/geoip.dat'
uci -q get wloc.main.geoip_url >/dev/null || uci -q set wloc.main.geoip_url='https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat'
uci -q get wloc.main.geoip_auto_update >/dev/null || uci -q set wloc.main.geoip_auto_update='0'
uci -q commit wloc
exit 0
