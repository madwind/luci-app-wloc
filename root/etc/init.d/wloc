#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

UCODE=/usr/bin/ucode
SCHEDULE=/usr/libexec/wloc/wifi-schedule.uc
WLOC_CTL=/usr/libexec/wloc/wlocctl
START_ERROR=/var/run/wloc/start-error

startup_failure() {
    local reason="$1"
    printf '%s\n' "$reason" >"$START_ERROR"
    logger -t wlocd "$reason"
    return 1
}

schedule_rule_enabled() {
    local section="$1" rule_enabled schedule_enabled

    config_get_bool rule_enabled "$section" enabled 1
    config_get_bool schedule_enabled "$section" schedule_enabled 0
    [ "$rule_enabled" -eq 1 ] && [ "$schedule_enabled" -eq 1 ] && schedule_required=1
}

has_wifi_schedule() {
    local schedule_required=0

    config_foreach schedule_rule_enabled wifi
    [ "$schedule_required" -eq 1 ]
}

start_service() {
    local enabled debug_log check_detail

    config_load wloc
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0

    mkdir -p /var/run/wloc
    rm -f /var/run/wloc/status.json "$START_ERROR"

    if ! check_detail="$("$WLOC_CTL" check 2>&1)"; then
        [ -n "$check_detail" ] || check_detail='unknown configuration error'
        startup_failure "wlocd configuration validation failed: $check_detail"
        return 1
    fi

    mkdir -p /etc/wloc
    chmod 0700 /etc/wloc
    config_get_bool debug_log main debug_log 0

    if has_wifi_schedule; then
        procd_open_instance schedule
        procd_set_param command "$UCODE" "$SCHEDULE" run
        procd_set_param respawn 60 5 3
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_set_param file /etc/config/wloc /etc/config/wireless
        procd_close_instance
    fi

    procd_open_instance daemon
    procd_set_param command "$WLOC_CTL" run-guarded
    procd_set_param env WLOC_PROFILE_PATH=/www/wloc-ca.mobileconfig \
        WLOC_STATUS_PATH=/var/run/wloc/status.json \
        WLOC_START_ERROR_PATH="$START_ERROR" \
        WLOC_DEBUG_LOG="$debug_log"
    procd_set_param respawn 60 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/wloc /etc/config/wireless
    procd_close_instance
}

service_stopped() {
    rm -f /var/run/wloc/status.json "$START_ERROR"
}

reload_service() {
    config_load wloc
    config_get_bool enabled main enabled 0
    if [ "$enabled" -eq 1 ]; then
        stop
        start
    else
        stop
    fi
}

service_triggers() {
    procd_add_reload_trigger wloc
}
