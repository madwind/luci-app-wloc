#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

UCODE=/usr/bin/ucode
RULES=/usr/libexec/wloc/rules.uc
FIREWALL=/etc/wloc/firewall.nft
FIREWALL_DEFAULT=/usr/share/wloc/defaults/firewall.nft
FIREWALL_CTL=/usr/libexec/wloc/firewall.uc
SCHEDULE=/usr/libexec/wloc/wifi-schedule.uc
AP_CTL=/usr/libexec/wloc/ap.uc
START_ERROR=/var/run/wloc/start-error
rule_count=0
rule_error=''
wifi_sections=''
tproxy_marks=''

collect_wifi() {
    wifi_sections="$wifi_sections $1"
}

rule_index() {
    local target="$1" section index=0
    for section in $wifi_sections; do
        [ "$section" = "$target" ] && { printf '%s\n' "$index"; return 0; }
        index=$((index + 1))
    done
    return 1
}

tproxy_defaults() {
    local section="$1" index
    index="$(rule_index "$section")" || return 1
    TPROXY_DEFAULT_PORT=$((12345 + index))
    TPROXY_DEFAULT_MARK=$((1 | ((index & 255) << 8) | ((index >> 8) << 17)))
}

validate_wifi() {
    local section enabled name iface latitude longitude outbound tproxy_port tproxy_mark mark_value mark_digits seen_mark
    section="$1"
    config_get_bool enabled "$section" enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get iface "$section" iface ''
    name="$iface"
    config_get latitude "$section" latitude
    config_get longitude "$section" longitude
    config_get outbound "$section" outbound direct
    config_get tproxy_port "$section" tproxy_port
    config_get tproxy_mark "$section" tproxy_mark
    if [ "$outbound" = tproxy ]; then
        tproxy_defaults "$section" || { rule_error="unable to calculate TPROXY defaults for AP: $name"; return 0; }
        [ -n "$tproxy_port" ] || tproxy_port="$TPROXY_DEFAULT_PORT"
        [ -n "$tproxy_mark" ] || tproxy_mark="0x$(printf '%x' "$TPROXY_DEFAULT_MARK")"
    fi
    [ -n "$latitude" ] && [ -n "$longitude" ] || {
        rule_error="incomplete location parameters for AP: $name"; return 0;
    }
    [ -n "$iface" ] || { rule_error='interface is required for every enabled WLOC rule'; return 0; }
    if ! "$UCODE" "$AP_CTL" find "$iface" >/dev/null 2>&1; then
        rule_error="interface \"$iface\" cannot be resolved"; return 0
    fi
    case "$outbound" in
        direct) ;;
        tproxy)
            case "$tproxy_port" in *[!0-9]*|'') rule_error="invalid TPROXY port for AP: $name"; return 0;; esac
            [ "$tproxy_port" -ge 1 ] 2>/dev/null && [ "$tproxy_port" -le 65535 ] 2>/dev/null || {
                rule_error="invalid TPROXY port for AP: $name"; return 0;
            }
            case "$tproxy_mark" in
                0x*|0X*)
                    mark_digits="${tproxy_mark#0x}"; mark_digits="${mark_digits#0X}"
                    case "$mark_digits" in ''|*[!0-9A-Fa-f]*) rule_error="invalid TPROXY mark for AP: $name"; return 0;; esac
                    ;;
                ''|*[!0-9]*) rule_error="invalid TPROXY mark for AP: $name"; return 0;;
            esac
            mark_value=$((tproxy_mark))
            [ "$mark_value" -gt 0 ] 2>/dev/null && [ "$mark_value" -le 4294967295 ] 2>/dev/null || {
                rule_error="invalid TPROXY mark for AP: $name"; return 0;
            }
            [ $((mark_value & 0xc0010000)) -eq 0 ] || {
                rule_error="TPROXY mark uses WLOC reserved bits for AP: $name"; return 0;
            }
            seen_mark=" $mark_value "
            case " $tproxy_marks " in *"$seen_mark"*) rule_error="duplicate TPROXY mark for AP: $name"; return 0;; esac
            tproxy_marks="$tproxy_marks $mark_value"
            ;;
        *) rule_error="invalid outbound type for AP: $name (use direct or tproxy)"; return 0;;
    esac
    rule_count=$((rule_count + 1))
}

append_rule_for_wifi() {
    local section enabled name iface latitude longitude outbound tproxy_port tproxy_mark
    section="$1"
    config_get_bool enabled "$section" enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get iface "$section" iface ''
    name="$iface"
    config_get latitude "$section" latitude
    config_get longitude "$section" longitude
    config_get outbound "$section" outbound direct
    config_get tproxy_port "$section" tproxy_port
    config_get tproxy_mark "$section" tproxy_mark
    if [ "$outbound" = tproxy ]; then
        tproxy_defaults "$section" || return 1
        [ -n "$tproxy_port" ] || tproxy_port="$TPROXY_DEFAULT_PORT"
        [ -n "$tproxy_mark" ] || tproxy_mark="0x$(printf '%x' "$TPROXY_DEFAULT_MARK")"
    fi
    procd_append_param command --rule "$section" "$iface" "$latitude" "$longitude"
    procd_append_param command --rule-name "$section" "$name"
    [ "$outbound" = tproxy ] && \
        procd_append_param command --rule-tproxy "$section" "$tproxy_port" "$tproxy_mark"
}

startup_failure() {
    local reason="$1"
    printf '%s\n' "$reason" >"$START_ERROR"
    logger -t wlocd "$reason"
    return 1
}

startup_warning() {
    local reason="$1"
    printf '%s\n' "$reason" >"$START_ERROR"
    logger -t wlocd "WARNING: $reason"
}

start_service() {
    local firewall_source firewall_apply_detail cleanup_detail
    mkdir -p /var/run/wloc
    rm -f /var/run/wloc/status.json /var/run/wloc/package.version "$START_ERROR"
    firewall_source="$FIREWALL"
    [ -r "$firewall_source" ] || firewall_source="$FIREWALL_DEFAULT"
    if ! firewall_apply_detail="$("$UCODE" "$FIREWALL_CTL" apply-file "$firewall_source" 2>&1)"; then
        cleanup_detail=''
        if cleanup_detail="$("$UCODE" "$FIREWALL_CTL" remove-runtime 2>&1)"; then
            startup_warning "firewall apply failed: ${firewall_apply_detail:-unknown error}; stale WLOC runtime was removed"
        else
            [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
            startup_failure "firewall apply failed: ${firewall_apply_detail:-unknown error}; fail-open cleanup failed: $cleanup_detail"
            return 1
        fi
    fi
    config_load wloc

    procd_open_instance schedule
    procd_set_param command "$UCODE" "$SCHEDULE" run
    procd_set_param respawn 60 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/wloc /etc/config/wireless
    procd_close_instance

    config_get_bool enabled main enabled 0
    config_get listen_port main listen_port 61520
    config_get_bool debug main debug 0
    config_get_bool debug_log main debug_log 0

    cleanup_detail=''
    if cleanup_detail="$("$UCODE" "$RULES" reset 2>&1)"; then
        :
    else
        [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
        startup_failure "runtime cleanup failed: $cleanup_detail; interception remains disabled"
        return 1
    fi
    [ "$enabled" -eq 1 ] || return 0
    case "$listen_port" in ''|*[!0-9]*) startup_failure 'invalid local listen port; interception remains disabled'; return 1;; esac
    [ "$listen_port" -ge 1 ] 2>/dev/null && [ "$listen_port" -le 65535 ] 2>/dev/null || {
        startup_failure 'invalid local listen port; interception remains disabled'; return $?;
    }
    rule_count=0
    rule_error=''
    wifi_sections=''
    tproxy_marks=''
    config_foreach collect_wifi wifi
    for wifi in $wifi_sections; do
        validate_wifi "$wifi"
        [ -z "$rule_error" ] || break
    done
    [ -z "$rule_error" ] || { startup_failure "$rule_error; interception remains disabled"; return $?; }
    [ "$rule_count" -gt 0 ] || { startup_failure 'no enabled rules; interception remains disabled'; return $?; }

    mkdir -p /etc/wloc
    chmod 0700 /etc/wloc

    procd_open_instance daemon
    procd_set_param command /usr/sbin/wlocd --listen-port "$listen_port" --rules-helper "$RULES"
    [ "$debug" -eq 1 ] && procd_append_param command --debug
    for wifi in $wifi_sections; do
        append_rule_for_wifi "$wifi"
    done
    procd_set_param env WLOC_PROFILE_PATH=/www/wloc-ca.mobileconfig \
        WLOC_STATUS_PATH=/var/run/wloc/status.json \
        WLOC_START_ERROR_PATH="$START_ERROR" \
        WLOC_DEBUG_LOG="$debug_log"
    procd_set_param respawn 60 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/wloc
    procd_close_instance
}

stop_service() {
    local rc=0 cleanup_detail
    if cleanup_detail="$("$UCODE" "$RULES" reset 2>&1)"; then
        :
    else
        [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
        logger -t wlocd "runtime cleanup failed while stopping service: $cleanup_detail"
        rc=1
    fi
    return "$rc"
}

service_stopped() {
    local rc=0 cleanup_detail
    if cleanup_detail="$("$UCODE" "$RULES" reset 2>&1)"; then
        :
    else
        [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
        logger -t wlocd "runtime cleanup failed after service stop: $cleanup_detail"
        rc=1
    fi
    rm -f /var/run/wloc/status.json "$START_ERROR" || rc=1
    return "$rc"
}

reload_service() {
    pidof wlocd >/dev/null 2>&1 || return 0
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger wloc
}
