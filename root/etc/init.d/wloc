#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

RULES=/usr/libexec/wloc/rules.sh
FIREWALL=/etc/wloc/firewall.nft
FIREWALL_HELPER=/usr/libexec/wloc/firewall.sh
SCHEDULE=/usr/libexec/wloc/wifi-schedule.sh
AP_LIB=/usr/libexec/wloc/ap-lib.sh
START_ERROR=/var/run/wloc/start-error
rule_count=0
rule_error=''
wifi_sections=''

collect_wifi() {
    wifi_sections="$wifi_sections $1"
}

validate_wifi() {
    local section enabled name iface latitude longitude proxy_type proxy_host proxy_port
    section="$1"
    config_get_bool enabled "$section" enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get iface "$section" iface ''
    name="$iface"
    config_get latitude "$section" latitude
    config_get longitude "$section" longitude
    config_get proxy_type "$section" proxy_type direct
    config_get proxy_host "$section" proxy_host
    config_get proxy_port "$section" proxy_port
    [ -n "$latitude" ] && [ -n "$longitude" ] || {
        rule_error="incomplete location parameters for AP: $name"; return 0;
    }
    [ -n "$iface" ] || { rule_error='interface is required for every enabled WLOC rule'; return 0; }
    . "$AP_LIB"
    if ! wloc_ap_find_section_by_ifname "$iface" >/dev/null; then
        rule_error="interface \"$iface\" cannot be resolved"; return 0
    fi
    case "$proxy_type" in
        direct) ;;
        socks5)
            [ -n "$proxy_host" ] && [ -n "$proxy_port" ] || {
                rule_error="incomplete SOCKS5 proxy for AP: $name"; return 0;
            }
            case "$proxy_port" in *[!0-9]*|'') rule_error="invalid proxy port for AP: $name"; return 0;; esac
            [ "$proxy_port" -ge 1 ] 2>/dev/null && [ "$proxy_port" -le 65535 ] 2>/dev/null || {
                rule_error="invalid proxy port for AP: $name"; return 0;
            }
            ;;
        *) rule_error="invalid outbound type for AP: $name (use direct or socks5)"; return 0;;
    esac
    rule_count=$((rule_count + 1))
}

append_rule_for_wifi() {
    local section enabled name iface latitude longitude proxy_type proxy_host proxy_port
    section="$1"
    config_get_bool enabled "$section" enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get iface "$section" iface ''
    name="$iface"
    config_get latitude "$section" latitude
    config_get longitude "$section" longitude
    config_get proxy_type "$section" proxy_type direct
    config_get proxy_host "$section" proxy_host
    config_get proxy_port "$section" proxy_port
    procd_append_param command --rule "$section" "$iface" "$latitude" "$longitude"
    procd_append_param command --rule-name "$section" "$name"
    [ "$proxy_type" = direct ] || \
        procd_append_param command --rule-proxy "$section" "$proxy_type" "$proxy_host" "$proxy_port"
}

startup_failure() {
    local reason="$1"
    printf '%s\n' "$reason" >"$START_ERROR"
    logger -t wlocd "$reason"
    return 1
}

startup_warning() {
    local reason="$1"
    printf '%s\n' "$reason" >"$START_ERROR"
    logger -t wlocd "WARNING: $reason"
}

start_service() {
    mkdir -p /var/run/wloc
    rm -f /var/run/wloc/status.json /var/run/wloc/package.version "$START_ERROR"
    if ! firewall_apply_detail="$("$FIREWALL_HELPER" apply "$FIREWALL" 2>&1)"; then
        startup_warning "firewall apply failed: ${firewall_apply_detail:-unknown error}"
    fi
    config_load wloc

    procd_open_instance schedule
    procd_set_param command "$SCHEDULE" run
    procd_set_param respawn 3600 5 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/wloc /etc/config/wireless
    procd_close_instance

    config_get_bool enabled main enabled 0
    config_get listen_port main listen_port 61520
    config_get_bool debug main debug 0

    cleanup_detail=''
    if cleanup_detail="$("$RULES" cleanup 2>&1)"; then
        :
    else
        [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
        startup_failure "firewall cleanup failed: $cleanup_detail; interception remains disabled"
        return 1
    fi
    [ "$enabled" -eq 1 ] || return 0
    case "$listen_port" in ''|*[!0-9]*) startup_failure 'invalid local listen port; interception remains disabled'; return 1;; esac
    [ "$listen_port" -ge 1 ] 2>/dev/null && [ "$listen_port" -le 65535 ] 2>/dev/null || {
        startup_failure 'invalid local listen port; interception remains disabled'; return $?;
    }
    rule_count=0
    rule_error=''
    wifi_sections=''
    config_foreach collect_wifi wifi
    for wifi in $wifi_sections; do
        validate_wifi "$wifi"
        [ -z "$rule_error" ] || break
    done
    [ -z "$rule_error" ] || { startup_failure "$rule_error; interception remains disabled"; return $?; }
    [ "$rule_count" -gt 0 ] || { startup_failure 'no enabled rules; interception remains disabled'; return $?; }

    mkdir -p /etc/wloc
    chmod 0700 /etc/wloc

    procd_open_instance daemon
    procd_set_param command /usr/sbin/wlocd --listen-port "$listen_port"
    [ "$debug" -eq 1 ] && procd_append_param command --debug
    for wifi in $wifi_sections; do
        append_rule_for_wifi "$wifi"
    done
    procd_set_param env WLOC_PROFILE_PATH=/www/wloc-ca.mobileconfig \
        WLOC_STATUS_PATH=/var/run/wloc/status.json \
        WLOC_START_ERROR_PATH="$START_ERROR"
    procd_set_param respawn 3600 5 60
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/wloc
    procd_close_instance
}

stop_service() {
    local rc=0 cleanup_detail
    if cleanup_detail="$("$RULES" cleanup 2>&1)"; then
        :
    else
        [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
        logger -t wlocd "firewall cleanup failed while stopping service: $cleanup_detail"
        rc=1
    fi
    return "$rc"
}

service_stopped() {
    local rc=0 cleanup_detail
    "$SCHEDULE" stop >/dev/null 2>&1 || true
    if cleanup_detail="$("$RULES" cleanup 2>&1)"; then
        :
    else
        [ -n "$cleanup_detail" ] || cleanup_detail='unknown error'
        logger -t wlocd "firewall cleanup failed after service stop: $cleanup_detail"
        rc=1
    fi
    rm -f /var/run/wloc/status.json "$START_ERROR" || rc=1
    return "$rc"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger wloc
}
